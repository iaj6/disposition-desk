# --- Model (required for the agent; tests, `npm run check` and the shipment list work without it) ---
ANTHROPIC_API_KEY=
DISPOSITION_MODEL=anthropic/claude-opus-5
# Alternative: Gemini on Vertex AI with Google ADC (gcloud auth application-default login)
# DISPOSITION_MODEL=vertex/gemini-2.5-pro
# GOOGLE_VERTEX_PROJECT=
# GOOGLE_VERTEX_LOCATION=us-central1

# --- Sanity project (Studio at /studio, seed script, deterministic tool) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=      # Editor token, only for `npm run seed`
SANITY_API_READ_TOKEN=       # Viewer token, only if the dataset is private
SANITY_STUDIO_HOST=          # your own hostname for `npx sanity deploy` (<host>.sanity.studio)
SANITY_STUDIO_APP_ID=        # printed by the first deploy; keeps later deploys from prompting

# --- Sanity Context MCP (Path One). Org-level token with Context Viewer. Leave blank to run offline on groq-js. ---
SANITY_CONTEXT_TOKEN=
SANITY_CONTEXT_MCP_URL=https://api.sanity.io/v1/context/organizations/<orgId>/mcp/<endpoint>
SANITY_CONTEXT_KB_MCP_URL=https://api.sanity.io/v1/context/organizations/<orgId>/mcp/<endpoint>?mode=knowledge_base&knowledgeBases=<kb id>
